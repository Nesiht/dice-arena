{
  "name": "dice-arena",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "mobile:start": "npm run start --workspace=@dice-arena/mobile",
    "mobile:android": "npm run android --workspace=@dice-arena/mobile",
    "mobile:ios": "npm run ios --workspace=@dice-arena/mobile",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "npm run typecheck --workspace=@dice-arena/game-domain && npm run typecheck --workspace=@dice-arena/mobile",
    "test": "jest --watch=false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^57.0.9",
    "eslint": "^9.31.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.2"
  }
}
